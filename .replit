modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/luxe-boutique: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/api-server: api"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/luxe-boutique-mobile: expo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/luxe-boutique-admin: admin"

[[workflows.workflow]]
name = "artifacts/luxe-boutique: web"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=22805 BASE_PATH=/ pnpm --filter @workspace/luxe-boutique run dev"
waitForPort = 22805

[[workflows.workflow]]
name = "artifacts/api-server: api"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8000 pnpm --filter @workspace/api-server run dev"
waitForPort = 8000

[[workflows.workflow]]
name = "artifacts/luxe-boutique-mobile: expo"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3002 pnpm --filter @workspace/luxe-boutique-mobile run dev"
waitForPort = 3002

[[workflows.workflow]]
name = "artifacts/luxe-boutique-admin: admin"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 pnpm --filter @workspace/luxe-boutique-admin run dev"
waitForPort = 5000

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 90000

[nix]
channel = "stable-25_05"
