# ─────────────────────────────────────────────────────────────
#  LUXE BOUTIQUE — Environment Variables Reference
#  Copy this file to .env for local development.
#  In Replit, add these via the Secrets tab (padlock icon).
# ─────────────────────────────────────────────────────────────

# ── Database (auto-provisioned by Replit — do not edit) ──────
DATABASE_URL=postgresql://user:password@host:5432/dbname
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development

# Public-facing URL of the frontend (leave blank in dev)
# Production example: https://luxeboutique.replit.app
FRONTEND_URL=

# ── Google OAuth ─────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com
#   APIs & Services → Credentials → Create OAuth 2.0 Client ID
#   Application type: Web application
#   Authorised redirect URIs: https://yourdomain.com/api/auth/google/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match the redirect URI registered in Google Cloud Console
# Dev:  http://localhost:8080/api/auth/google/callback
# Prod: https://yourdomain.com/api/auth/google/callback
GOOGLE_CALLBACK_URL=

# ── Admin OTP Email (SMTP) ────────────────────────────────────
# Used to send the 6-digit sign-in code to admin accounts.
# If not set, the code is displayed directly in the UI (dev only).
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-app-password   ← generate at myaccount.google.com/apppasswords
#
# Resend / SendGrid / Mailgun also work — just change HOST/PORT/USER/PASS.

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Luxe Boutique <no-reply@luxeboutique.com>

# ── Session ───────────────────────────────────────────────────
# Auto-generated by Replit — do not edit
SESSION_SECRET=
